{
  "name": "smartdeck",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "SmartDeck — IA + ciência cognitiva para estudar melhor",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "pdfjs-dist": "^4.10.38",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
